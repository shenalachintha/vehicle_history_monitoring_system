// Prisma schema for FleetGuard Pro
// Supported database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FLEET_MANAGER
  MAINTENANCE_OFFICER
  MILEAGE_RECORDER
  VIEWER
}

enum VehicleCategory {
  CAR
  VAN
  PICKUP
  LORRY
  BUS
  MOTORCYCLE
  SPECIALIZED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum VehicleStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum LocationStatus {
  MOVING
  STOPPED
  OFFLINE
}

enum EventType {
  ROUTINE_SERVICE
  REPAIR_BREAKDOWN
  ACCIDENT_INCIDENT
  RECALL
  INSPECTION
  INSURANCE
  REGISTRATION_LICENSING
  CHEMICAL_ADDITIVE
  DIESEL_TUNEUP
  ENGINE_MAINTENANCE
  BRAKE_MAINTENANCE
  TYRE_MAINTENANCE
  BATTERY_MAINTENANCE
  COOLING_MAINTENANCE
  ELECTRICAL_MAINTENANCE
  WARRANTY_CLAIM
  PARTS_REPLACEMENT
  OTHER
}

enum ItemType {
  PART
  FLUID
  ADDITIVE
  CONSUMABLE
  LABOR
  OTHER
}

enum ConditionType {
  DATE_ONLY
  MILEAGE_ONLY
  DATE_OR_MILEAGE
  DATE_AND_MILEAGE
}

enum AlertType {
  SERVICE_DUE_DATE
  SERVICE_DUE_MILEAGE
  OVERDUE_MAINTENANCE
  DOCUMENT_EXPIRY
  MISSING_WEEKLY_MILEAGE
  HIGH_COST_ANOMALY
  VEHICLE_OUT_OF_SERVICE
  OPEN_REPAIR_FOLLOWUP
}

enum AlertSeverity {
  INFO
  UPCOMING
  DUE
  OVERDUE
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DocumentType {
  INSURANCE
  REVENUE_LICENCE
  FITNESS_CERTIFICATE
  EMISSION_TEST
  REGISTRATION_CARD
  LEASE_AGREEMENT
  INVOICE
  INSPECTION_REPORT
  PHOTO
  OTHER
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  role             Role              @default(VIEWER)
  department       String?
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  mileageReadings  MileageReading[]
  eventsCreated    VehicleEvent[]
  documentsCreated VehicleDocument[]
  alertsAcked      Alert[]           @relation("AlertAck")
  alertsResolved   Alert[]           @relation("AlertResolve")
  auditLogs        AuditLog[]
}

model Vehicle {
  id                  String             @id @default(uuid())
  registrationNo      String             @unique
  vin                 String?
  make                String
  model               String
  year                Int
  category            VehicleCategory    @default(CAR)
  fuelType            FuelType           @default(PETROL)
  transmission        TransmissionType   @default(AUTOMATIC)
  chassisNo           String?
  engineNo            String?
  status              VehicleStatus      @default(ACTIVE)
  currentOdometer     Decimal            @default(0.00) @db.Decimal(10, 2)
  odometerLastUpdated DateTime           @default(now())
  assignedDriver      String?
  driverContact       String?
  department          String?
  branch              String?
  operationalLocation String?
  currentLatitude     Float?
  currentLongitude    Float?
  locationStatus      LocationStatus     @default(STOPPED)
  purchaseDate        DateTime?
  purchasePrice       Decimal?           @db.Decimal(12, 2)
  supplier            String?
  warrantyDetails     String?
  warrantyExpiry      DateTime?
  thumbnailUrl        String?
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mileageReadings     MileageReading[]
  events              VehicleEvent[]
  maintenanceRules    MaintenanceRule[]
  documents           VehicleDocument[]
  alerts              Alert[]

  @@index([registrationNo])
  @@index([status])
  @@index([category])
}

model MileageReading {
  id                String       @id @default(uuid())
  vehicleId         String
  recordedDate      DateTime     @default(now())
  odometerReading   Decimal      @db.Decimal(10, 2)
  distanceTravelled Decimal      @default(0.00) @db.Decimal(10, 2)
  isCorrection      Boolean      @default(false)
  correctionReason  String?
  isFlagged         Boolean      @default(false)
  flagReason        String?
  weekNumber        Int
  year              Int
  recordedById      String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy        User         @relation(fields: [recordedById], references: [id])

  @@index([vehicleId, recordedDate])
  @@index([year, weekNumber])
}

model VehicleEvent {
  id                 String       @id @default(uuid())
  vehicleId          String
  eventType          EventType    @default(ROUTINE_SERVICE)
  title              String
  eventDate          DateTime     @default(now())
  odometerAtEvent    Decimal      @db.Decimal(10, 2)
  issueDescription   String?      @db.Text
  workPerformed      String       @db.Text
  serviceProvider    String
  technicianName     String?
  laborCost          Decimal      @default(0.00) @db.Decimal(10, 2)
  partsCost          Decimal      @default(0.00) @db.Decimal(10, 2)
  otherCost          Decimal      @default(0.00) @db.Decimal(10, 2)
  totalCost          Decimal      @default(0.00) @db.Decimal(10, 2)
  currency           String       @default("USD")
  recommendations    String?      @db.Text
  nextServiceDate    DateTime?
  nextServiceMileage Decimal?     @db.Decimal(10, 2)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy          User         @relation(fields: [createdById], references: [id])
  items              EventItem[]

  @@index([vehicleId, eventDate])
  @@index([eventType])
}

model EventItem {
  id            String       @id @default(uuid())
  eventId       String
  description   String
  itemType      ItemType     @default(PART)
  brand         String?
  specification String?
  quantity      Decimal      @default(1.00) @db.Decimal(8, 2)
  unitCost      Decimal      @default(0.00) @db.Decimal(10, 2)
  totalPrice    Decimal      @default(0.00) @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())

  event         VehicleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model MaintenanceRule {
  id                 String           @id @default(uuid())
  name               String
  category           String           // e.g. "Engine Oil", "Diesel Fuel System", "Tire Rotation"
  vehicleId          String?
  vehicleCategory    VehicleCategory?
  conditionType      ConditionType    @default(DATE_OR_MILEAGE)
  intervalMonths     Int?
  intervalKm         Decimal?         @db.Decimal(10, 2)
  warningDaysBefore  Int              @default(30)
  warningKmBefore    Decimal          @default(500.00) @db.Decimal(10, 2)
  criticalOverdueDays Int             @default(15)
  criticalOverdueKm  Decimal          @default(200.00) @db.Decimal(10, 2)
  isRecurring        Boolean          @default(true)
  lastCompletedDate  DateTime?
  lastCompletedKm    Decimal?         @db.Decimal(10, 2)
  nextDueDate        DateTime?
  nextDueKm          Decimal?         @db.Decimal(10, 2)
  isActive           Boolean          @default(true)
  instructions       String?          @db.Text
  responsibleDept    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  alerts             Alert[]

  @@index([vehicleId])
  @@index([isActive])
}

model Alert {
  id                   String         @id @default(uuid())
  vehicleId            String
  ruleId               String?
  documentId           String?
  alertType            AlertType
  severity             AlertSeverity  @default(INFO)
  title                String
  message              String         @db.Text
  dueDate              DateTime?
  dueMileage           Decimal?       @db.Decimal(10, 2)
  currentMileageAtAlert Decimal?      @db.Decimal(10, 2)
  status               AlertStatus    @default(OPEN)
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  resolvedById         String?
  resolvedAt           DateTime?
  resolutionNotes      String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  vehicle              Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rule                 MaintenanceRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  document             VehicleDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  acknowledgedBy       User?          @relation("AlertAck", fields: [acknowledgedById], references: [id])
  resolvedBy           User?          @relation("AlertResolve", fields: [resolvedById], references: [id])

  @@index([vehicleId, status])
  @@index([documentId, status])
  @@index([severity, status])
}

model VehicleDocument {
  id             String       @id @default(uuid())
  vehicleId      String
  docType        DocumentType @default(INSURANCE)
  title          String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  warningDaysBefore Int       @default(30)
  fileUrl        String
  fileSize       Int          @default(0)
  notes          String?      @db.Text
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])
  alerts         Alert[]

  @@index([vehicleId])
  @@index([expiryDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
